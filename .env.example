# Comma-separated browser origins permitted to call the API in production.
ALLOWED_ORIGINS=https://www.example.com

# Set only when the app is behind a known number of reverse proxies.
TRUST_PROXY_HOPS=1

# SMTP contact-form credentials and verified SendGrid sender.
EMAIL_USER=
EMAIL_PASS=
SENDGRID_API_KEY=
SENDGRID_SENDER=
